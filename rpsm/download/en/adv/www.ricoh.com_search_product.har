            "size": 9606,
            "mimeType": "text/css",
            "text": "#section01 .c-section:not(.c-section--relation){\n  padding-top: 0;\n}\n.clm{\n  font-family: \"Frutiger LT W01_55 Roma1475738\"!important;\n}\n.sct_bg01{\n  overflow: hidden;\n  zoom:1;\n}\n.wrap__select{\n  width: 100%;\n}\n.wrap__select .selector{\n  width:100%;\n}\n#sortBoxWrap{\n  background-color: #f8f8f8;\n  border: 1px solid #dedede;\n  margin-bottom: 72px;\n}\n.c-container .sortBox__title{\n    font-size: 22px;\n    line-height: 44px;\n    font-feature-settings: \"palt\";\n    letter-spacing: 0.01em;\n    border-bottom: 1px solid #dedede;\n    padding: 12px 30px;\n    background-color: #ebebeb;\n}\n@media (max-width: 640px){\n  .c-container .sortBox__title{\n    font-size: 16px;\n    line-height: 28px;\n    padding: 18px;\n  }\n}\n.c-container .sortBox__subtitle{\n    font-size: 20px;\n    line-height: 1.6em;\n    font-feature-settings: \"palt\";\n    letter-spacing: 0.01em;\n    width: calc(100% - 82px);\n    margin-left: auto;\n    margin-right: auto;\n    padding-bottom: 12px;\n    padding-top: 34px;\n}\n@media (max-width: 640px){\n  .c-container .sortBox__subtitle{\n    font-size: 16px;\n    width: calc(100% - 24px);\n  }\n}\n.sort_radiobtGroup{\n    width: calc(100% - 82px);\n    margin-left: auto;\n    margin-right: auto;\n    padding-bottom: 24px;\n}\n@media (max-width: 640px){\n  .sort_radiobtGroup{\n    width: calc(100% - 24px);\n  }\n  .sort_radiobtGroup span{\n    display: block;\n  }\n  .sort_radiobtGroup span + span{\n    padding-top: 12px;\n  }\n}\n.sort_radiobtGroup + .sortBox__subtitle{\n  border-top: 1px solid #dedede;\n}\n\n\n\n#sortBox,\n#sortBox__keyword{\n  width: 100%);\n  padding-top: 0;\n  padding-bottom: 0;\n}\n@media (max-width: 640px){\n  #sortBox,\n  #sortBox__keyword{\n    width: 100%;\n  }\n}\n#sortBox[hidden],\n#sortBox__keyword[hidden] {\n  display: none !important;\n}\n#sortBox h3,\n#sortBox__keyword h3{\n  margin-left: auto;\n  margin-right: auto;\n  font-size: 18px;\n  font-weight: bold;\n  white-space: nowrap;\n  background-color: #f8f8f8;\n  position: relative;\n  cursor: pointer;\n  text-align: left;\n  background-image: url(/-/Media/Ricoh/Sites/jp_ricoh/security/products/vulnerabilities/img/icon_search.svg);\n  background-repeat: no-repeat;\n  background-size: 40px 40px;\n  background-position: 50px center;\n  padding: 30px 10px;\n  padding-left: 100px;\n}\n@media (max-width: 640px){\n  #sortBox h3,\n  #sortBox__keyword h3{\n    background-size: 28px 28px;\n    padding-left: 55px;\n    background-position: 20px center;\n    font-size: 16px;\n    padding-top: 10px;\n    padding-bottom: 10px;\n    padding-right: 40px;\n    white-space: inherit;\n    text-align: left;\n  }\n}\n.button.act01.js-btSearch{\n  min-width: 200px;\n  font-size: 16px;\n}\n@media (max-width: 640px){\n  .js-btSearch{\n    width: 100%;\n  }\n}\n/* #sortBox__keyword h3{\n  border-top: 1px solid #dedede;\n}\n#sortBox h3::before,\n#sortBox__keyword h3::before{\n  content:\"\";\n  position: absolute;\n  width: 20px;\n  height: 2px;\n  background-color: #ccc;\n  top:50%;\n  right: 15px;\n}\n#sortBox h3::after,\n#sortBox__keyword h3::after{\n  content:\"\";\n  position: absolute;\n  width: 20px;\n  height: 2px;\n  background-color: #ccc;\n  transform: rotate(90deg);\n  top:50%;\n  right: 15px;\n  transition: .4s;\n} */\n.sortBoxInner{\n  width: calc(100% - 82px);\n  margin-left: auto;\n  margin-right: auto;\n  justify-content: space-between;\n  align-items: flex-start;\n  border-top: none;\n  padding:40px 40px 30px 40px;\n  padding-top: 0;\n  background-color: #f8f8f8;\n  overflow: hidden;\n}\n@media (max-width: 640px){\n  .sortBoxInner{\n    width: calc(100% - 24px);\n    padding:12px;\n    padding-bottom: 34px;\n    padding-top: 0;\n  }\n}\n.sortBoxInner input.nml[type=text] {\n    padding: 8px 24px;\n    font-size: 16px;\n    line-height: 32px;\n}\n#sortBox h3.isOpen + .sortBoxInner,\n#sortBox__keyword h3.isOpen + .sortBoxInner{\n  display: block;\n}\n\n#sortBox h3.isOpen::after,\n#sortBox__keyword h3.isOpen::after{\n  transform: rotate(0deg);\n}\n.w100{\n  margin-bottom: 8px;\n}\n.wrap__select .button{\n  margin-left: auto;\n  margin-right: auto;\n  display:block\n}\n.sortbox_labelAndInput{\n  display: flex;\n  justify-content: flex-start;\n  align-items: center;\n  flex-wrap: wrap;\n}\n@media (max-width: 640px){\n  .sortbox_labelAndInput{\n    display: block;\n  }\n}\n.sortbox_labelAndInput label{\n  width: 240px;\n  font-weight: bold;\n}\n@media (max-width: 640px){\n  .sortbox_labelAndInput label{\n    width: 100%;\n    padding-bottom: 4px;\n    display: block;\n  }\n}\n.sortbox_labelAndInput .c-select-b,\n.sortbox_labelAndInput input.nml[type=text]{\n  width: calc(100% - 240px);\n  box-sizing: border-box;\n}\n@media (max-width: 640px){\n  .sortbox_labelAndInput .c-select-b,\n  .sortbox_labelAndInput input.nml[type=text]{\n    width: 100%;\n  }\n}\n.current__number{\n  padding-bottom: 8px;\n}\n.padTop80px{\n  padding-top: 80px;\n}\n.hd05{\n  padding-bottom: 8px;\n}\n.button.act01{\n  font-size: 14px;\n  -webkit-font-smoothing: antialiased;\n  letter-spacing: 0.01em;\n}\n.searchBox__wrap{\n  display: flex;\n  justify-content: space-between;\n}\n.searchBox__byProduct{\n}\n.searchBox__byProduct .dtl input.nml[type=text]{\n  width: 500px;\n  padding: 14px 8px;\n}\n.searchBox__byProduct .dtl .button.act01{\n  width: 80px;\n}\n.searchBox__vul{\n  text-align: right;\n}\n.searchBox__vul .dtl input{\n  width: 240px;\n  padding: 16px 16px 15px;\n}\n.button.act01{\n  padding: 16px 16px 15px;\n}\n.c-container .list_productsTable__title{\n  font-size: 24px;\n  padding-bottom: 20px;\n}\n@media (max-width: 640px){\n  .c-container .list_productsTable__title{\n    font-size: 16px;\n  }\n}\n.list_productsTableWrap{\n  padding: 0;\n}\n@media (max-width: 640px){\n  .list_productsTableWrap{\n    padding: 8px;\n  }\n}\ntable.nml thead th,\ntable.nml tbody td{\n  font-size: 16px;\n}\n.cveList{\n  display: block;\n}\n#vulWrap_cover {\n    width: 100%;\n    height: 100%;\n    position: fixed;\n    top: 0;\n    left: 0;\n    background-color: #fff;\n    opacity: 0;\n    display: none;\n    z-index: 9999;\n}\n#vulinfoApp .cnt_max{\n  max-width: initial;\n}\n.searchTab{\n  display: flex;\n  justify-content: space-between;\n  border-top: 1px solid #dedede;\n  border-left: 1px solid #dedede;\n  border-right: 1px solid #dedede;\n  margin: 32px auto 32px;\n  border-radius: 2px;\n  padding-top: 0;\n  padding-left: 0;\n}\n.searchTab li{\n  width: 50%;\n  padding: 0;\n  margin: 0;\n  background: #f3f3f3;\n}\n.searchTab li a{\n  line-height: 1.5em;\n  text-align: center;\n  display: block;\n  padding: 16px;\n}\n.searchTab li:first-child{\n  border-right: 1px solid #dedede;\n  background: #fff;\n}\n.searchTab--keyword li:first-child{\n  background: #f3f3f3;\n}\n.searchTab--keyword li:last-child{\n  background: #fff;\n}\n\n.searchAttention{\n  font-size: 12px;\n  letter-spacing: 0.01em;\n  padding-top: 8px;\n  padding-bottom: 8px;\n  width: 100%;\n  padding-left: 240px;\n  box-sizing: border-box;\n}\n@media (max-width: 640px){\n  #sortBox{\n    width: 100%;\n    margin-left: auto;\n    margin-right: auto;\n  }\n  .nml_scrollAddWrap{\n    overflow: hidden;\n    overflow-x: scroll;\n    -webkit-overflow-scrolling : touch\n  }\n  .nml_scrollAddWrap .nml{\n    min-width: 1007px;\n  }\n  .searchTab{\n    width: 100%;\n    padding-left: 0;\n  }\n  .searchTab li{\n    font-size: 14px;\n  }\n  .searchTab li{\n    display: flex;\n    align-items: center;\n  }\n  #sortBox, #sortBox__keyword{\n    width: 100%;\n    padding-left: 0;\n    padding-right: 0;\n  }\n}\ntable.nml {\n    border-top: 1px solid #cfcfcf;\n    border-left: 1px solid #cfcfcf;\n}\ntable.nml th, table.nml td {\n    border-right: 1px solid #cfcfcf;\n    border-bottom: 1px solid #cfcfcf;\n}\n.paging_nv .pg_nv_prev{\n  width: 260px;\n}\n.paging_nv .pg_nv_follow{\n  width: 260px;\n}\n@media (max-width: 640px){\n  .paging_nv .pg_nv_prev{\n    width: 127px;\n  }\n  .paging_nv .pg_nv_follow{\n    width: 127px;\n  }\n}\n#vulinfoApp .c-select-b:has(option[disabled][value=\"\"]:checked) {\n  color: #757575;\n}\n.sortBoxInner .wrap__select select{\n    border: 1px solid #C9C9C9;\n    font-feature-settings: \"palt\";\n}\n\n\n@media (max-width: 640px){\n  #vulinfoApp .clm{\n    padding-left: 0;\n    padding-right: 0;\n  }\n}\n\n.pg_nv_first .c-button-a__text{\n  transform: scale(0,0);\n}\n.pg_nv_last .c-button-a__text{\n  transform: scale(0,0);\n}\n.pg_nv_lst{\n  padding: 0;\n}\n#vulinfoApp .c-button-a--small{\n  height: 40px;\n  font-family: sans-serif;\n}\n\n#vulinfoApp table.nml{\n  border-left: none;\n}\n#vulinfoApp table.nml thead th{\n  padding-left: 24px;\n  font-size: 16px;\n}\n#vulinfoApp table.nml thead th,\n#vulinfoApp table.nml tbody td{\n  padding-top: 18px;\n  padding-bottom: 18px;\n  border-left: none;\n  border-right: none;\n}\n\n.sort_radiobtGroup input{\n  -webkit-appearance:auto;\n  appearance: auto;\n}\n.sort_radiobtGroup label {\n  position: relative;\n  cursor: pointer;\n  padding-left: 34px;\n  margin-right: 20px;\n}\n\n.sort_radiobtGroup label::before,\n.sort_radiobtGroup label::after {\n  content: \"\";\n  display: block; \n  border-radius: 50%;\n  position: absolute;\n  transform: translateY(-50%);\n  top: 50%;\n}\n\n.sort_radiobtGroup label::before {\n  background-color: #fff;\n  border: 1px solid #cccccc;\n  border-radius: 50%;\n  width: 20px;\n  height: 20px;\n  left: 5px;\n}\n\n.sort_radiobtGroup label::after {\n  background-color: #7a7a7a;\n  border-radius: 50%;\n  opacity: 0;\n  width: 12px;\n  height: 12px;\n  left: 10px\n}\n\n.sort_radiobtGroup input:checked + label::after {\n  opacity: 1;\n}\n\n.sort_radiobtGroup .visually-hidden {\n position: absolute;\n white-space: nowrap;\n border: 0;\n clip: rect(0 0 0 0);\n clip-path: inset(50%);\n overflow: hidden;\n height: 1px;\n width: 1px;\n margin: -1px;\n padding: 0;\n}\n\n/**ページング**/\n@media (max-width: 640px){\n  #vulinfoApp .paging_nv .pg_nv_lst li.act a:before{\n    display: inline-block;\n    position: relative;\n    width: auto;\n  }\n  #vulinfoApp .c-button-a--white .c-button-a__text{\n    display: inline-block;\n  }\n}\n\n\n"
